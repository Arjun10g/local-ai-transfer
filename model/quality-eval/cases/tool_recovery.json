        "temperature": 0,
        "max_output_tokens": 224,
        "enable_thinking": false
      },
      "expected": {
        "metric": "final_task_success",
        "max_tool_calls": 4,
        "tool_transcript": [
          {
            "call": {
              "name": "fs.search_text",
              "arguments": {
                "workspace_id": "project-alpha",
                "query": "cancellation",
                "max_depth": 16
              }
            },
            "result": {
              "status": "error",
              "code": "max_depth_out_of_range"
            }
          },
          {
            "call": {
              "name": "fs.search_text",
              "arguments": {
                "workspace_id": "project-alpha",
