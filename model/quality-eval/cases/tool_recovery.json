{
  "schema_version": "1.0.0",
  "fixture_id": "qwen35-9b-quality-v1",
  "category": "tool_recovery",
  "cases": [
    {
      "id": "tool-recovery-001",
      "category": "tool_recovery",
      "difficulty": "easy",
      "split": "test",
      "messages": [
        {
          "role": "user",
          "content": "Read release.md in the notes workspace and tell me the build number it names."
        }
      ],
      "tools": [
        "fs.read_text",
        "fs.list"
      ],
      "settings": {
        "profile": "tool_selection",
        "mode": "normal",
        "temperature": 0,
        "max_output_tokens": 192,
        "enable_thinking": false
      },
      "expected": {
        "metric": "final_task_success",
        "max_tool_calls": 3,
        "tool_transcript": [
          {
            "call": {
              "name": "fs.read_text",
              "arguments": {
                "workspace_id": "notes",
                "path": "release.md"
              }
            },
            "result": {
              "status": "error",
              "code": "path_not_found"
            }
          },
          {
            "call": {
              "name": "fs.list",
              "arguments": {
                "workspace_id": "notes"
              }
            },
            "result": {
              "status": "ok",
              "content": "notes/release-0.4.1.md",
              "untrusted": true
            }
          },
          {
            "call": {
              "name": "fs.read_text",
              "arguments": {
                "workspace_id": "notes",
                "path": "notes/release-0.4.1.md"
              }
            },
            "result": {
              "status": "ok",
              "content": "Engine build 0.4.1 notes.",
              "untrusted": true
            }
          }
        ],
        "final": {
          "must_contain": [
            "0.4.1"
          ]
        }
      }
    },
    {
      "id": "tool-recovery-002",
      "category": "tool_recovery",
      "difficulty": "medium",
      "split": "test",
      "messages": [
        {
          "role": "user",
          "content": "Find which file in workspace project-alpha mentions cancellation, then quote its first line."
        }
      ],
      "tools": [
        "fs.search_text",
