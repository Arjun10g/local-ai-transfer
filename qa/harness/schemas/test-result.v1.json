{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "local-assistant-engine/qa/test-result.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "test_id", "status", "kind", "duration_ms"],
  "properties": {
    "schema_version": {"const": "test-result.v1"},
    "test_id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]+$"},
    "status": {"enum": ["PASS", "FAIL", "SKIP"]},
    "kind": {"enum": ["fixture", "static", "native", "shadeform", "windows", "real-model"]},
    "duration_ms": {"type": "integer", "minimum": 0},
    "details": {"type": "object"},
    "artifact": {"type": ["string", "null"]}
  }
}
