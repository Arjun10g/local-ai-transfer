    {"id":"prod-teams-send-001","category":"confirmation_sensitive","messages":[{"role":"user","content":"Send the exact body hello to the existing Teams chat whose trusted chat_id is c-1."}],"expected":{"call":{"name":"teams.send_message","arguments":{"chat_id":"c-1","body":"hello"}}}},
