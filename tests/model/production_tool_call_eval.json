    {"id":"prod-browser-activate-001","category":"confirmation_sensitive","messages":[{"role":"user","content":"A trusted inspection returned browser_session_id b-1, page_revision rev-1, and control_id control-1. Activate exactly that inspected safe control."}],"expected":{"call":{"name":"browser.activate_control","arguments":{"browser_session_id":"b-1","page_revision":"rev-1","control_id":"control-1"}}}},
