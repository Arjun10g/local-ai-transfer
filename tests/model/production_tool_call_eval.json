    {"id":"prod-mail-read-001","category":"tool_selection","messages":[{"role":"user","content":"Read the trusted message with message id m-1, returning at most 2048 bytes."}],"expected":{"call":{"name":"mail.read_message","arguments":{"message_id":"m-1","max_bytes":2048}}}},
