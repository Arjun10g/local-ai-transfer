    {"id":"prod-mail-send-001","category":"confirmation_sensitive","messages":[{"role":"user","content":"After confirmation, send the existing draft whose trusted draft id is exactly d-1."}],"expected":{"call":{"name":"mail.send_draft","arguments":{"draft_id":"d-1"}}}},
