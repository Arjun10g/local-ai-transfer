{
  "schema": "local_bmo.tool-call-eval.v1",
  "model": "Qwen3.5-9B-Q4_K_M",
  "protocol": "qwen35-xml-tool-call-v1",
  "limits": {"context_tokens": 8192, "max_output_tokens": 256, "temperature": 0, "max_cases": 32},
  "tools": [
    {"type":"function","function":{"name":"time.now","description":"Return local wall-clock time, UTC time, offset, and monotonic metadata.","parameters":{"type":"object","properties":{"format":{"type":"string","enum":["local","utc","iso"]}},"additionalProperties":false}}},
    {"type":"function","function":{"name":"system.get_info","description":"Return bounded local runtime information.","parameters":{"type":"object","properties":{},"additionalProperties":false}}},
    {"type":"function","function":{"name":"clipboard.read","description":"Read the local clipboard when supported.","parameters":{"type":"object","properties":{},"additionalProperties":false}}},
    {"type":"function","function":{"name":"clipboard.write","description":"Write text to the local clipboard when supported.","parameters":{"type":"object","properties":{"text":{"type":"string","maxLength":65536}},"required":["text"],"additionalProperties":false}}},
    {"type":"function","function":{"name":"app.open","description":"Open an allowlisted local application.","parameters":{"type":"object","properties":{"app_id":{"type":"string","maxLength":64}},"required":["app_id"],"additionalProperties":false}}},
    {"type":"function","function":{"name":"browser.open_url","description":"Open an HTTPS URL after local policy checks.","parameters":{"type":"object","properties":{"url":{"type":"string","maxLength":2048}},"required":["url"],"additionalProperties":false}}},
    {"type":"function","function":{"name":"fs.list","description":"List entries in an approved workspace directory.","parameters":{"type":"object","properties":{"workspace_id":{"type":"string","maxLength":64},"path":{"type":"string","maxLength":4096},"max_entries":{"type":"integer","minimum":1,"maximum":500}},"required":["workspace_id"],"additionalProperties":false}}},
    {"type":"function","function":{"name":"fs.read_text","description":"Read bounded UTF-8 text from an approved workspace file.","parameters":{"type":"object","properties":{"workspace_id":{"type":"string","maxLength":64},"path":{"type":"string","maxLength":4096},"offset_bytes":{"type":"integer","minimum":0,"maximum":1048576},"max_bytes":{"type":"integer","minimum":1,"maximum":65536}},"required":["workspace_id","path"],"additionalProperties":false}}},
    {"type":"function","function":{"name":"fs.search_text","description":"Search literal text in approved workspace files.","parameters":{"type":"object","properties":{"workspace_id":{"type":"string","maxLength":64},"path":{"type":"string","maxLength":4096},"query":{"type":"string","maxLength":4096},"max_files":{"type":"integer","minimum":1,"maximum":200},"max_matches":{"type":"integer","minimum":1,"maximum":500},"max_depth":{"type":"integer","minimum":0,"maximum":16}},"required":["workspace_id","query"],"additionalProperties":false}}},
    {"type":"function","function":{"name":"fs.write_new","description":"Create a new file in an approved workspace.","parameters":{"type":"object","properties":{"workspace_id":{"type":"string","maxLength":64},"path":{"type":"string","maxLength":4096},"content":{"type":"string","maxLength":65536}},"required":["workspace_id","path","content"],"additionalProperties":false}}},
    {"type":"function","function":{"name":"fs.apply_patch","description":"Apply a guarded replacement or patch to an approved workspace file.","parameters":{"type":"object","properties":{"workspace_id":{"type":"string","maxLength":64},"path":{"type":"string","maxLength":4096},"base_sha256":{"type":"string","pattern":"^[a-fA-F0-9]{64}$"},"base_hash":{"type":"string","pattern":"^[a-fA-F0-9]{64}$"},"replacement":{"type":"string","maxLength":2097152},"patch":{"type":"string","maxLength":2097152}},"required":["workspace_id","path"],"oneOf":[{"required":["base_sha256","replacement"],"not":{"anyOf":[{"required":["base_hash"]},{"required":["patch"]}]}},{"required":["base_sha256","patch"],"not":{"anyOf":[{"required":["base_hash"]},{"required":["replacement"]}]}},{"required":["base_hash","replacement"],"not":{"anyOf":[{"required":["base_sha256"]},{"required":["patch"]}]}},{"required":["base_hash","patch"],"not":{"anyOf":[{"required":["base_sha256"]},{"required":["replacement"]}]}}],"additionalProperties":false}}},
    {"type":"function","function":{"name":"process.run_allowlisted","description":"Run one fixed operator-configured local action with bounded output. The executable is an unsandboxed operator trust boundary and may access the network.","parameters":{"type":"object","additionalProperties":false,"required":["action_id"],"properties":{"action_id":{"type":"string","minLength":1,"maxLength":64},"parameters":{"type":"object","additionalProperties":false,"properties":{}}}}}},
    {"type":"function","function":{"name":"mail.list_messages","description":"List bounded Outlook messages from the signed-in user mailbox.","parameters":{"type":"object","additionalProperties":false,"required":[],"properties":{"folder":{"type":"string","maxLength":32,"enum":["inbox","sentitems","drafts","archive"]},"unread_only":{"type":"boolean"},"limit":{"type":"integer","minimum":1,"maximum":25}}}}},
    {"type":"function","function":{"name":"mail.read_message","description":"Read bounded plain text from one Outlook message.","parameters":{"type":"object","additionalProperties":false,"required":["message_id"],"properties":{"message_id":{"type":"string","maxLength":512,"minLength":1},"max_bytes":{"type":"integer","minimum":1,"maximum":65536}}}}},
    {"type":"function","function":{"name":"mail.create_draft","description":"Create one Outlook draft after confirmation.","parameters":{"type":"object","additionalProperties":false,"required":["to","subject","body"],"properties":{"to":{"type":"array","minItems":1,"maxItems":20,"items":{"type":"string","maxLength":320}},"cc":{"type":"array","maxItems":20,"items":{"type":"string","maxLength":320}},"subject":{"type":"string","maxLength":998},"body":{"type":"string","maxLength":65536}}}}},
    {"type":"function","function":{"name":"mail.send_draft","description":"Send one existing Outlook draft after high-impact confirmation.","parameters":{"type":"object","additionalProperties":false,"required":["draft_id"],"properties":{"draft_id":{"type":"string","maxLength":512,"minLength":1}}}}},
    {"type":"function","function":{"name":"mail.mark_read","description":"Change the read state of one Outlook message.","parameters":{"type":"object","additionalProperties":false,"required":["message_id","is_read"],"properties":{"message_id":{"type":"string","maxLength":512,"minLength":1},"is_read":{"type":"boolean"}}}}},
    {"type":"function","function":{"name":"teams.list_chats","description":"List bounded existing Teams chats for the signed-in user.","parameters":{"type":"object","additionalProperties":false,"required":[],"properties":{"limit":{"type":"integer","minimum":1,"maximum":25}}}}},
    {"type":"function","function":{"name":"teams.list_messages","description":"List bounded messages from one existing Teams chat.","parameters":{"type":"object","additionalProperties":false,"required":["chat_id"],"properties":{"chat_id":{"type":"string","maxLength":512,"minLength":1},"limit":{"type":"integer","minimum":1,"maximum":50}}}}},
    {"type":"function","function":{"name":"teams.send_message","description":"Send one message to an existing Teams chat after high-impact confirmation.","parameters":{"type":"object","additionalProperties":false,"required":["chat_id","body"],"properties":{"chat_id":{"type":"string","maxLength":512,"minLength":1},"body":{"type":"string","maxLength":16384,"minLength":1}}}}},
    {"type":"function","function":{"name":"coding.copilot_ask","description":"Ask GitHub Copilot for a bounded prompt-only answer with explicitly selected context.","parameters":{"type":"object","additionalProperties":false,"required":["prompt","workspace_id","context_paths"],"properties":{"prompt":{"type":"string","minLength":1,"maxLength":8192},"workspace_id":{"type":"string","minLength":1,"maxLength":64},"context_paths":{"type":"array","maxItems":8,"items":{"type":"string","minLength":1,"maxLength":1024}}}}}},
    {"type":"function","function":{"name":"browser.session_start","description":"Open a public HTTPS page in a new visible temporary browser session.","parameters":{"type":"object","additionalProperties":false,"required":["url"],"properties":{"url":{"type":"string","minLength":1,"maxLength":2048}}}}},
    {"type":"function","function":{"name":"browser.inspect_links","description":"Inspect bounded visible links from the current browser page.","parameters":{"type":"object","additionalProperties":false,"required":["browser_session_id"],"properties":{"browser_session_id":{"type":"string","minLength":1,"maxLength":128},"limit":{"type":"integer","minimum":1,"maximum":50}}}}},
    {"type":"function","function":{"name":"browser.inspect_page","description":"Inspect bounded visible page text and safe interactive controls.","parameters":{"type":"object","additionalProperties":false,"required":["browser_session_id"],"properties":{"browser_session_id":{"type":"string","minLength":1,"maxLength":128},"max_text":{"type":"integer","minimum":1,"maximum":16384},"max_controls":{"type":"integer","minimum":1,"maximum":50}}}}},
    {"type":"function","function":{"name":"browser.follow_link","description":"Follow one previously inspected public HTTPS link after confirmation.","parameters":{"type":"object","additionalProperties":false,"required":["browser_session_id","page_revision","link_id"],"properties":{"browser_session_id":{"type":"string","minLength":1,"maxLength":128},"page_revision":{"type":"string","minLength":1,"maxLength":128},"link_id":{"type":"string","minLength":1,"maxLength":128}}}}},
    {"type":"function","function":{"name":"browser.fill_field","description":"Enter bounded non-sensitive text into one previously inspected visible field after confirmation.","parameters":{"type":"object","additionalProperties":false,"required":["browser_session_id","page_revision","control_id","value"],"properties":{"browser_session_id":{"type":"string","minLength":1,"maxLength":128},"page_revision":{"type":"string","minLength":1,"maxLength":128},"control_id":{"type":"string","minLength":1,"maxLength":128},"value":{"type":"string","maxLength":4096}}}}},
    {"type":"function","function":{"name":"browser.activate_control","description":"Activate one previously inspected safe visible browser control after confirmation.","parameters":{"type":"object","additionalProperties":false,"required":["browser_session_id","page_revision","control_id"],"properties":{"browser_session_id":{"type":"string","minLength":1,"maxLength":128},"page_revision":{"type":"string","minLength":1,"maxLength":128},"control_id":{"type":"string","minLength":1,"maxLength":128}}}}},
    {"type":"function","function":{"name":"browser.session_close","description":"Close an owned temporary browser session.","parameters":{"type":"object","additionalProperties":false,"required":["browser_session_id"],"properties":{"browser_session_id":{"type":"string","minLength":1,"maxLength":128}}}}}
  ],
  "cases": [
