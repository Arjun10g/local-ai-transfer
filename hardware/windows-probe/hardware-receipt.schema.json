{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local-assistant-engine.invalid/hardware/windows-receipt-1.0.0.schema.json",
  "title": "Local Assistant Engine Windows hardware receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "receipt_kind", "generated_at_utc", "collection", "os", "computer", "cpu", "gpu_adapters", "display_drivers", "vulkan", "approved_runtime_dlls", "storage", "sycl_level_zero", "safety"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "receipt_kind": {"const": "windows-hardware-receipt"},
    "generated_at_utc": {"type": "string", "format": "date-time"},
    "collection": {"type": "object", "additionalProperties": false, "required": ["read_only", "admin_required", "network_changed", "secrets_collected"], "properties": {"read_only": {"const": true}, "admin_required": {"const": false}, "network_changed": {"const": false}, "secrets_collected": {"const": false}}},
    "os": {"type": "object", "additionalProperties": false, "properties": {"caption": {"type": ["string", "null"]}, "version": {"type": ["string", "null"]}, "build": {"type": ["string", "null"]}, "architecture": {"type": ["string", "null"]}, "service_pack": {"type": ["string", "null"]}}},
    "computer": {"type": "object", "additionalProperties": false, "properties": {"manufacturer": {"type": ["string", "null"]}, "model": {"type": ["string", "null"]}, "system_family": {"type": ["string", "null"]}, "total_memory_bytes": {"type": ["integer", "null"]}, "available_memory_bytes": {"type": ["integer", "null"]}}},
    "cpu": {"type": "array"},
    "gpu_adapters": {"type": "array"},
    "display_drivers": {"type": "array"},
    "vulkan": {"type": "object"},
    "approved_runtime_dlls": {"type": "object"},
    "storage": {"type": "array"},
    "sycl_level_zero": {"type": "object"},
    "safety": {"type": "object", "additionalProperties": false, "required": ["no_environment_dump", "no_credentials", "no_network_changes", "no_driver_install", "no_model_access"], "properties": {"no_environment_dump": {"const": true}, "no_credentials": {"const": true}, "no_network_changes": {"const": true}, "no_driver_install": {"const": true}, "no_model_access": {"const": true}}}
  }
}
