{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lae://contracts/config-schema/0.1.0",
  "title": "Local Assistant Host Configuration",
  "version": "0.1.0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {"const": "0.1.0"},
    "host": {"type": "object", "additionalProperties": false, "properties": {"bind": {"const": "127.0.0.1"}, "max_body_bytes": {"type": "integer", "minimum": 1024, "maximum": 1048576}, "request_timeout_ms": {"type": "integer", "minimum": 100, "maximum": 120000}, "max_connections": {"type": "integer", "minimum": 1, "maximum": 256}, "max_header_bytes": {"type": "integer", "minimum": 1024, "maximum": 65536}, "max_header_count": {"type": "integer", "minimum": 8, "maximum": 256}}},
    "engine": {"type": "object", "additionalProperties": false, "properties": {"mode": {"enum": ["fixture", "native"]}, "endpoint": {"type": "string", "maxLength": 512}, "model": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$"}, "backend": {"type": "string", "pattern": "^[A-Za-z0-9._/-]{1,128}$"}, "request_timeout_ms": {"type": "integer", "minimum": 1000, "maximum": 120000}}},
    "workspace_roots": {"type": "array", "maxItems": 16, "items": {"oneOf": [{"type": "string", "minLength": 1, "maxLength": 1024}, {"type": "object", "additionalProperties": false, "required": ["id", "path"], "properties": {"id": {"type": "string", "minLength": 1, "maxLength": 64}, "path": {"type": "string", "minLength": 1, "maxLength": 1024}, "read": {"type": "boolean"}, "write": {"type": "boolean"}}}]}},
    "applications": {"type": "object", "maxProperties": 16, "propertyNames": {"pattern": "^[A-Za-z0-9_.-]{1,64}$"}, "additionalProperties": {"type": "object", "additionalProperties": false, "required": ["executable", "args"], "properties": {"executable_id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,64}$"}, "executable": {"type": "string", "minLength": 1, "maxLength": 1024}, "args": {"type": "array", "maxItems": 16, "items": {"type": "string", "maxLength": 1024}}}}},
    "process_actions": {"type":"object","additionalProperties":false,"properties":{"enabled":{"type":"boolean"},"actions":{"type":"object","maxProperties":32,"propertyNames":{"pattern":"^[A-Za-z0-9_.-]{1,64}$"},"additionalProperties":{"type":"object","additionalProperties":false,"required":["executable","args","workspace_id","cwd"],"properties":{"executable":{"type":"string","minLength":1,"maxLength":1024,"pattern":"^(?!//)(?:/|[A-Za-z]:[\\\\/])","not":{"pattern":"(?:^|[\\\\/])(?:powershell|powershell_ise|pwsh|cmd|wscript|cscript|mshta|bash|sh|zsh|fish|python|python3|node|deno|ruby|perl|rundll32|regsvr32|msiexec|installutil)(?:\\\\.exe)?$"}},"args":{"type":"array","maxItems":32,"items":{"type":"string","maxLength":1024}},"workspace_id":{"type":"string","pattern":"^[A-Za-z0-9_.-]{1,64}$"},"cwd":{"type":"string","maxLength":1024},"parameters":{"type":"object","maxProperties":16,"additionalProperties":false,"patternProperties":{"^[A-Za-z0-9_.-]{1,64}$":{"type":"object","additionalProperties":false,"required":["type"],"properties":{"type":{"enum":["string","integer","boolean"]},"max_length":{"type":"integer","minimum":1,"maximum":8192},"minimum":{"type":"integer"},"maximum":{"type":"integer"},"enum":{"type":"array","minItems":1,"maxItems":32,"items":{"type":"string","minLength":1,"maxLength":8192}},"argv_kind":{"enum":["identifier","relative_path","enum","scalar"]}}}}},"stdin_parameter":{"type":"string","maxLength":64},"timeout_ms":{"type":"integer","minimum":100,"maximum":110000},"max_stdout_bytes":{"type":"integer","minimum":1,"maximum":32768},"max_stderr_bytes":{"type":"integer","minimum":1,"maximum":32768}}}}}},
    "network": {"type": "object", "additionalProperties": false, "properties": {"provider": {"enum": ["disabled", "approved_http_search", "approved_http_fetch", "browser_open"]}}},
    "providers": {"type": "object", "additionalProperties": false, "properties": {
      "microsoft_graph": {"type": "object", "additionalProperties": false, "properties": {"enabled": {"type": "boolean"}, "permission_profile": {"description": "Confirmation profile; outbound caller-supplied search queries remain confirmation-gated under ask_before_writes and review_important_actions.", "enum": ["always_ask", "ask_before_writes", "review_important_actions", "full_access"]}, "account_fingerprint": {"type": "string", "minLength": 1, "maxLength": 256}, "scope": {"type": "string", "minLength": 1, "maxLength": 256}, "tenant": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9.-]{0,127}$"}, "client_id": {"type": "string", "format": "uuid"}, "scopes": {"type": "array", "minItems": 1, "maxItems": 9, "uniqueItems": true, "contains": {"const": "User.Read"}, "items": {"enum": ["User.Read", "Mail.Read", "Mail.ReadWrite", "Mail.Send", "Chat.Read", "Chat.ReadWrite", "ChatMessage.Send", "Channel.ReadBasic.All", "ChannelMessage.Read.All"]}}}, "allOf": [{"if": {"properties": {"permission_profile": {"const": "full_access"}}, "required": ["permission_profile"]}, "then": {"required": ["account_fingerprint"], "properties": {"account_fingerprint": {"not": {"const": "unknown"}}}}}]},
      "copilot": {"type": "object", "additionalProperties": false, "properties": {"enabled": {"type": "boolean"}, "executable": {"type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^(?!//)(?:/|[A-Za-z]:[\\\\/])"}, "allowlist": {"type": "array", "maxItems": 16, "items": {"type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^(?!//)(?:/|[A-Za-z]:[\\\\/])"}}, "version": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^v?\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$"}}},
      "browser_actions": {"type": "object", "additionalProperties": false, "properties": {"enabled": {"type": "boolean"}, "executable": {"type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^(?!//)(?:/|[A-Za-z]:[\\\\/])"}, "allowlist": {"type": "array", "maxItems": 16, "items": {"type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^(?!//)(?:/|[A-Za-z]:[\\\\/])"}}, "safe_actions": {"type": "boolean"}, "action_origins": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^https:\\/\\/[A-Za-z0-9.-]+(?::443)?\\/?$"}}}}
    }}
  }
}
