{
  "schema_version": "lae.action-journal-contract.v1",
  "$id": "lae://contracts/action-journal/0.1.0",
  "title": "Local Assistant foreground action-journal protocol",
  "version": "0.1.0",
  "status": "contract_only_not_enabled",
  "production_available": false,
  "runtime_dependency_added": false,
  "transport_selected": false,
  "limits": {
    "max_frame_bytes": 65536,
    "max_payload_bytes": 65532,
    "max_buffered_frames": 8,
    "max_session_frames_per_direction": 1024,
    "max_string_bytes": 2048,
    "max_object_fields": 24,
    "max_array_items": 128,
    "max_summary_records": 128,
    "max_detail_events": 32,
    "max_events_per_operation": 32,
    "max_deadline_span_ms": 600000,
    "max_future_clock_skew_ms": 30000
  },
  "framing": {
    "prefix": "uint32-big-endian-payload-byte-count",
    "payload": "one-canonical-json-object-encoded-as-strict-utf8",
    "canonical_json": "sorted-keys-no-whitespace-safe-integers-no-negative-zero-no-duplicate-keys",
    "mac": "HMAC-SHA256(key, protocol || NUL || canonical-json(envelope-without-mac))",
    "key_bytes": 32,
    "nonce_hex_bytes": 16,
    "sequence": "independent-per-direction-exact-next-from-zero",
    "request_id": "unique-within-the-bounded-session"
  },
  "methods": [
    "health",
    "prepare",
    "authorize",
    "dispatch",
    "acknowledge",
    "begin_reconciliation",
    "complete",
    "cancel",
    "fail_definitive",
    "mark_unknown",
    "summary",
    "detail"
  ],
  "event_actions": [
    "prepare",
    "authorize",
    "dispatch",
    "acknowledge",
    "begin_reconciliation",
    "complete",
    "cancel",
    "fail_definitive",
    "mark_unknown",
    "startup_recovery"
  ],
  "states": [
    "prepared",
    "authorized",
    "dispatching",
    "acknowledged",
    "reconciling",
    "completed",
    "cancelled",
    "failed_definitive",
    "unknown_manual"
  ],
  "risk_tiers": ["T0", "T1", "T2", "T3", "T4"],
  "authorization_kinds": ["policy", "user_confirmation", "operator_grant"],
  "side_effects": [
    "browser_activation",
    "browser_close",
    "browser_input",
    "browser_navigation",
    "browser_read",
    "cloud_inference",
    "create",
    "external_navigation",
    "launch",
    "none",
    "process_execution",
    "read_sensitive",
    "replace",
    "write_sensitive"
  ],
  "resolutions": [
    "user_denied",
    "request_cancelled",
    "pre_dispatch_failure",
    "dispatch_ambiguous",
    "provider_acknowledged",
    "completed",
    "startup_recovery",
    "manual_completed",
    "manual_failed_definitive"
  ],
  "reconciliation_reasons": [
    "lost_ack",
    "provider_timeout",
    "transport_closed",
    "startup_recovery",
    "postcondition_pending"
  ],
  "error_retryability": {
    "invalid_frame": false,
    "invalid_utf8": false,
    "invalid_json": false,
    "duplicate_key": false,
    "noncanonical_json": false,
    "unknown_field": false,
    "invalid_request": false,
    "invalid_mac": false,
    "replay": false,
    "sequence_out_of_order": false,
    "nonce_mismatch": false,
    "deadline_expired": false,
    "queue_full": true,
    "not_found": false,
    "invalid_transition": false,
    "commit_non_cancellable": false,
    "platform_unavailable": false,
    "record_limit_exceeded": false,
    "internal": false
  },
  "request_envelope": {
    "additionalProperties": false,
    "required": [
      "body",
      "deadline_at_ms",
      "issued_at_ms",
      "kind",
      "mac",
      "method",
      "nonce",
      "operation_id",
      "request_id",
      "sequence",
      "version"
    ],
    "constants": {"version": 1, "kind": "request"},
    "patterns": {
      "request_id": "^req_[a-f0-9]{32}$",
      "nonce": "^[a-f0-9]{32}$",
      "operation_id": "^act_[a-f0-9]{32}$",
      "mac": "^[a-f0-9]{64}$"
    },
    "time": "0 <= issued_at_ms < deadline_at_ms <= 4102444800000; span <= 600000"
  },
  "response_envelope": {
    "additionalProperties": false,
    "required": [
      "body",
      "error",
      "kind",
      "mac",
      "method",
      "nonce",
      "operation_id",
      "request_id",
      "sequence",
      "state",
      "version"
    ],
    "constants": {"version": 1, "kind": "response"},
    "patterns": {
      "request_id": "^req_[a-f0-9]{32}$",
      "nonce": "^[a-f0-9]{32}$",
      "operation_id": "^act_[a-f0-9]{32}$",
      "mac": "^[a-f0-9]{64}$"
    }
  },
  "response_correlation": {
    "queue": "bounded lockstep requests already sent by the client",
    "exact": ["request_id", "method", "operation_id", "request_deadline"],
    "prepare_exception": "a successful prepare returns one non-null helper-created operation_id; a prepare error returns null",
    "summary": "record count is request-limited, operation ids are strictly increasing after cursor, a truncated page cursor equals its final record id, and include_terminal=false excludes every terminal state",
    "detail": "receipt.sequence is the authenticated high-watermark; after_event_digest binds the requested cursor to the authenticated predecessor event; return exactly min(limit, remaining) contiguous events beginning after after_sequence; every action/state/resolution/authorization transition is exact; truncated iff the final returned sequence is below the high-watermark; a complete final event exactly equals the receipt projection; an empty complete page requires predecessor and receipt equality at the high-watermark"
  },
  "terminal_states": ["completed", "cancelled", "failed_definitive"],
  "detail_page_binding": {
    "high_watermark": "receipt.sequence",
    "first_sequence": "after_sequence is null ? 0 : after_sequence + 1",
    "initial": "after_sequence and after_event_digest are null, predecessor is null, and event zero is prepare/prepared",
    "cursor": "non-null after_sequence requires after_event_digest equal SHA-256(protocol || NUL || the literal event || NUL || canonical-json(predecessor)), and predecessor.sequence equals after_sequence",
    "event_count": "min(limit, max(0, receipt.sequence - first_sequence + 1))",
    "adjacency": "predecessor to first event and every internal pair follow the exact action transition, resolution, and authorization continuity rules",
    "truncated": "events is nonempty and final event sequence is less than receipt.sequence",
    "complete": "next_sequence is null and final event exactly equals receipt projection, or after_sequence equals receipt.sequence with no events"
  },
  "error_response": {
    "body": {},
    "state": null,
    "error": "exact finite code plus contract-fixed retryability; no free-form detail"
  },
  "request_bodies": {
    "health": [],
    "prepare": [
      "arguments_digest",
      "call_ref",
      "operation_digest",
      "preview_digest",
      "request_ref",
      "risk_tier",
      "side_effect",
      "tool_name"
    ],
    "authorize": ["authorization_kind"],
    "dispatch": [],
    "acknowledge": ["provider_receipt_digest"],
    "begin_reconciliation": ["reason"],
    "complete": ["receipt_digest", "resolution"],
    "cancel": ["resolution"],
    "fail_definitive": ["resolution"],
    "mark_unknown": ["resolution"],
    "summary": ["cursor", "include_terminal", "limit"],
    "detail": ["after_event_digest", "after_sequence", "limit"]
  },
  "success_response_bodies": {
    "health": ["platform_available", "production_enabled", "recovery_count", "status"],
    "summary": ["next_cursor", "records", "truncated"],
    "detail": ["events", "next_sequence", "predecessor", "receipt", "truncated"],
    "mutations": ["receipt"]
  },
  "receipt_fields": [
    "authorization_kind",
    "operation_id",
    "receipt_digest",
    "recovery_required",
    "redacted",
    "resolution",
    "sequence",
    "state"
  ],
  "event_fields": [
    "action",
    "authorization_kind",
    "receipt_digest",
    "resolution",
    "sequence",
    "state"
  ],
  "receipt_state_rules": {
    "prepared": {"authorization": "null", "resolutions": [null]},
    "authorized": {"authorization": "required", "resolutions": [null]},
    "dispatching": {"authorization": "required", "resolutions": [null]},
    "acknowledged": {"authorization": "required", "resolutions": ["provider_acknowledged"]},
    "reconciling": {"authorization": "required", "resolutions": [null]},
    "completed": {"authorization": "required", "resolutions": ["completed", "manual_completed"]},
    "cancelled": {"authorization": "nullable", "resolutions": ["user_denied", "request_cancelled", "startup_recovery"]},
    "failed_definitive": {"authorization": "nullable", "resolutions": ["pre_dispatch_failure", "manual_failed_definitive"]},
    "unknown_manual": {"authorization": "required", "resolutions": ["dispatch_ambiguous"]}
  },
  "transitions": {
    "prepare": {"from": [null], "to": "prepared"},
    "authorize": {"from": ["prepared"], "to": "authorized"},
    "dispatch": {"from": ["authorized"], "to": "dispatching"},
    "acknowledge": {"from": ["dispatching"], "to": "acknowledged"},
    "begin_reconciliation": {"from": ["dispatching", "acknowledged"], "to": "reconciling"},
    "complete": {"from": ["acknowledged", "reconciling", "unknown_manual"], "to": "completed", "resolution_by_source": {"acknowledged": "completed", "reconciling": "completed", "unknown_manual": "manual_completed"}},
    "cancel": {"from": ["prepared", "authorized"], "to": "cancelled"},
    "fail_definitive": {"from": ["prepared", "authorized", "reconciling", "unknown_manual"], "to": "failed_definitive", "resolution_by_source": {"prepared": "pre_dispatch_failure", "authorized": "pre_dispatch_failure", "reconciling": "pre_dispatch_failure", "unknown_manual": "manual_failed_definitive"}},
    "mark_unknown": {"from": ["dispatching", "acknowledged", "reconciling"], "to": "unknown_manual"},
    "startup_recovery": {"from": ["prepared", "authorized", "dispatching", "acknowledged", "reconciling"], "to": ["cancelled", "unknown_manual"], "resolution_by_target": {"cancelled": "startup_recovery", "unknown_manual": "dispatch_ambiguous"}}
  },
  "recovery": {
    "prepared": {"state": "cancelled", "resolution": "startup_recovery"},
    "authorized": {"state": "cancelled", "resolution": "startup_recovery"},
    "dispatching": {"state": "unknown_manual", "resolution": "dispatch_ambiguous"},
    "acknowledged": {"state": "unknown_manual", "resolution": "dispatch_ambiguous"},
    "reconciling": {"state": "unknown_manual", "resolution": "dispatch_ambiguous"},
    "terminal_or_unknown": "unchanged"
  },
  "commit_semantics": {
    "dispatch": "durable-before-provider barrier; lost response requires detail, never replay",
    "complete": "internal durable section is noncancellable",
    "cancel_during_complete": "commit_non_cancellable followed by detail query",
    "startup": "never infer whether an external effect occurred"
  },
  "redaction": {
    "allowed": "finite envelope metadata, receipt_fields, and detail-only event_fields/predecessor only",
    "forbidden": "arguments previews provider payload content URLs commands credentials keys nonces logs"
  },
  "vectors": "v0.1.0-vectors.json"
}
