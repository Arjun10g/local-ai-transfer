{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local-assistant.invalid/contracts/windows-hardware-attestor/v1/receipt.schema.json",
  "title": "Inert Windows native hardware attestation receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["checks", "collector", "executed_on_target", "expected", "fixture", "generated_at_utc", "observed", "reason_codes", "receipt_kind", "schema_version", "target_evidence_accepted", "verdict"],
  "properties": {
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authenticode_valid", "board_exact", "cpu_exact", "deadline_supervised", "display_driver_exact", "dxgi_pnp_correlation_exact", "manifest_identity", "memory_exact", "operating_system_supported", "script_identity", "secure_boot_enabled", "self_identity", "vpro_authoritative", "vulkan_runtime_present"],
      "properties": {
        "authenticode_valid": {"type": "boolean"},
        "board_exact": {"type": "boolean"},
        "cpu_exact": {"type": "boolean"},
        "deadline_supervised": {"type": "boolean"},
        "display_driver_exact": {"type": "boolean"},
        "dxgi_pnp_correlation_exact": {"type": "boolean"},
        "manifest_identity": {"type": "boolean"},
        "memory_exact": {"type": "boolean"},
        "operating_system_supported": {"type": "boolean"},
        "script_identity": {"type": "boolean"},
        "secure_boot_enabled": {"type": "boolean"},
        "self_identity": {"type": "boolean"},
        "vpro_authoritative": {"type": "boolean"},
        "vulkan_runtime_present": {"type": "boolean"}
