{
  "api_version": "0.1.0",
  "auth": {"healthz": false, "other_routes": true, "failed_attempt_limit": 20, "window_ms": 60000},
  "limits": {"default_max_header_bytes": 16384, "default_max_header_count": 64},
  "post_content_type": "application/json[;charset=utf-8]",
  "exact_bodies": {
    "sessions": {"allowed": ["session_id", "reset"], "required": []},
    "chat": {"allowed": ["session_id", "request_id", "message", "mode", "tools"], "required": ["session_id", "request_id", "message"]},
    "cancel": {"allowed": ["request_id"], "required": ["request_id"]},
    "tool_confirmation": {"allowed": ["approved", "request_id", "call_id"], "required": ["approved", "request_id", "call_id"]},
    "operator_grant": {"allowed": ["granted", "duration_ms"], "required": ["granted"], "minimum_duration_ms": 60000, "maximum_duration_ms": 28800000},
    "operator_grant_revoke_all": {"allowed": [], "required": []},
    "shutdown": {"allowed": [], "required": []},
    "provider_auth_microsoft_graph": {"status": "GET /api/provider-auth/microsoft_graph", "actions": ["start", "cancel", "clear"], "allowed": [], "required": [], "unconfigured_start_status": 409, "public_status_fields": ["state", "prompt", "account_verified"], "public_prompt_fields": ["userCode", "verificationUri"], "public_status_excludes": ["access_token", "device_code", "tenant", "client_id", "scopes", "accountFingerprint"]}
  },
  "disconnect": "abort_active_chat",
  "operator_grants": {"storage": "memory_only", "binding": ["capability", "provider", "account_fingerprint", "scope"], "projection_excludes": ["account_fingerprint", "generation"], "shutdown": "revoke_all"}
}
