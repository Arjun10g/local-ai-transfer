{
  "api_version": "0.1.0",
  "auth": {"healthz": false, "other_routes": true, "failed_attempt_limit": 20, "window_ms": 60000},
  "limits": {"default_max_header_bytes": 16384, "default_max_header_count": 64},
  "post_content_type": "application/json[;charset=utf-8]",
  "exact_bodies": {
    "sessions": {"allowed": ["session_id", "reset"], "required": []},
    "chat": {"allowed": ["session_id", "request_id", "message", "mode", "tools"], "required": ["session_id", "request_id", "message"]},
    "cancel": {"allowed": ["request_id"], "required": ["request_id"]},
    "tool_confirmation": {"allowed": ["approved", "request_id", "call_id"], "required": ["approved", "request_id", "call_id"]},
    "operator_grant": {"allowed": ["granted", "duration_ms"], "required": ["granted"], "minimum_duration_ms": 60000, "maximum_duration_ms": 28800000},
    "operator_grant_revoke_all": {"allowed": [], "required": []},
    "shutdown": {"allowed": [], "required": []},
    "provider_auth_microsoft_graph": {"status": "GET /api/provider-auth/microsoft_graph", "actions": ["start", "cancel", "clear"], "allowed": [], "required": [], "unconfigured_start_status": 409, "public_status_fields": ["state", "prompt", "account_verified"], "public_prompt_fields": ["userCode", "verificationUri"], "public_status_excludes": ["access_token", "device_code", "tenant", "client_id", "scopes", "accountFingerprint"]}
  },
  "disconnect": "abort_active_chat",
  "operator_grants": {"storage": "memory_only", "binding": ["capability", "provider", "account_fingerprint", "scope"], "projection_excludes": ["account_fingerprint", "generation"], "shutdown": "revoke_all"},
  "delegate": {
    "enabled_by": ["config delegate.enabled: true", "LAE_DELEGATE_ENABLED=1"],
    "disabled": "every /api/delegate/* and /api/delegation* route answers 404; no key file and no host.json are written",
    "state_dir": {"win32": "%LOCALAPPDATA%\\BMO", "darwin": "~/Library/Application Support/BMO", "other": "${XDG_STATE_HOME:-~/.local/state}/bmo", "override": "BMO_STATE_DIR (absolute)", "posix_mode": "0700"},
    "host_file": {"name": "host.json", "mode": "0600", "write": "atomic at listen, overwrites a stale file", "remove": "on clean shutdown, only by the writing pid", "keys": ["version", "port", "pid", "started_at"], "version": 1},
    "key_file": {"name": "delegate-key", "mode": "0600", "format": "32 random bytes, base64url, 43 characters", "read": "on every delegate request, so rotation applies at once", "never": ["logged", "on a command line", "returned by any route"]},
    "bridge_auth": {"header": "Authorization: Bearer <delegate key>", "accepts": "only the delegate key (the UI bearer is refused)", "origin": "any Origin header -> 403", "host": "exactly 127.0.0.1:<port> or localhost:<port>, else 403", "failed_attempt_limit": 20, "window_ms": 60000, "limited": "429 {error:'auth_rate_limited', retry_after_s}", "counter": "separate from the UI bearer's"},
    "bridge_routes": {"POST /api/delegate/jobs": {"content_type": "application/json", "allowed": ["task", "context", "allow_files", "caller"], "required": ["task", "caller"], "caller": {"allowed": ["client", "name"], "required": ["client", "name"], "max_code_points": 64}, "task_max_code_points": 4000, "context_max_code_points": 16000, "max_body_bytes": 98304, "response": "202 {job_id, status}", "errors": {"400": "invalid_request_body | invalid_json", "409": "queue_full {retry_after_s}", "413": "task_too_large | context_too_large | job_too_large | body_too_large", "415": "unsupported_content_type", "429": "rate_limited {retry_after_s} (6 starts a minute)"}}, "GET /api/delegate/jobs/{job_id}?wait=0..15": {"job_id": "^[A-Za-z0-9_-]{8,64}$", "long_poll": "returns as soon as the job changes, else after wait seconds", "response": {"job_id": "string", "status": "queued|awaiting_approval|running|completed|failed|cancelled|denied|expired", "phase": "only while not finished: waiting_for_operator|waiting_for_engine|waiting_for_operator_chat|starting|generating|reading_files|using_tool", "elapsed_s": "integer", "answer": "only when completed, <= 8000 code points, credential-masked, control/bidi characters shown as ‹U+XXXX›", "error": "{code, message} only when failed|denied|expired", "truncated": "boolean"}, "errors": {"400": "invalid_request", "404": "job_not_found"}}, "POST /api/delegate/jobs/{job_id}/cancel": {"content_type": "application/json", "allowed": [], "required": [], "response": "200 {job_id, status}", "errors": {"404": "job_not_found"}}, "GET /api/delegate/health": {"response": {"ready": "boolean", "engine": "ready|not_ready", "queue": "jobs awaiting approval or queued", "busy": "boolean", "approval": "per_job|granted"}}},
    "operator_routes": {"GET /api/delegation": "UI bearer; {enabled, approval, queue, running, pending: [{job_id, caller, task, task_masked, task_chars, context_chars, allow_files, files_requested, workspaces, expires_in_ms}]}", "POST /api/delegation/jobs/{job_id}/decision": {"allowed": ["approved"], "required": ["approved"], "responses": {"200": "{accepted:true, status}", "404": "job_not_found", "409": "job_not_pending", "410": "approval_expired"}}, "POST /api/delegation/stop": {"allowed": [], "required": [], "response": "{cancelled}"}},
    "status_field": "GET /api/status includes delegate {enabled, queue, approval}",
    "grant": {"capability": "delegate.read_only_jobs", "approves": "delegated jobs only, at submission", "revocation": "cancels the jobs it approved"},
    "limits": {"pending_jobs": 3, "records": 20, "result_ttl_ms": 900000, "approval_timeout_ms_default": 120000, "max_runtime_ms_default": 600000, "max_output_tokens_default": 2048, "max_tool_calls_default": 4},
    "tools": ["time.now", "system.get_info", "fs.list, fs.read_text, fs.search_text only with allow_files and only over workspace_roots flagged delegate:true"],
    "priority": "a job waits while an operator turn or memory summary runs; an operator turn stops a running job, which is queued again (at most 3 times)",
    "persistence": "none: job text lives in memory only; the prompt is dropped when the job ends, the answer after result_ttl_ms"
  }
}
